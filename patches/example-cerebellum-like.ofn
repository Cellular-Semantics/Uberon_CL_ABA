Prefix(:=<http://purl.obolibrary.org/obo/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)

# Example patch: a proposed Uberon grouping term plus the CL grouping class it enables.
# EX_ IDs are placeholders for terms that exist on no branch yet.
Ontology(<http://example.org/workbench/patches/example-cerebellum-like.owl>

Declaration(Class(obo:EX_0000001))
Declaration(Class(obo:EX_0000002))
AnnotationAssertion(rdfs:label obo:EX_0000001 "cerebellum-like structure")
AnnotationAssertion(rdfs:label obo:EX_0000002 "cerebellum-like structure GABAergic neuron")

# Uberon side: groups structures by circuit architecture (is_a, not part_of)
SubClassOf(obo:EX_0000001 obo:UBERON_0002616)
SubClassOf(obo:UBERON_0002037 obo:EX_0000001)
SubClassOf(obo:UBERON_0002829 obo:EX_0000001)

# CL side: GABAergic neuron and (has soma location some cerebellum-like structure)
EquivalentClasses(obo:EX_0000002 ObjectIntersectionOf(obo:CL_0000617 ObjectSomeValuesFrom(obo:RO_0002100 obo:EX_0000001)))
)
