{
  "name": "cl-uberon-workbench",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "hostRequirements": { "memory": "16gb", "cpus": 4 },
  "postCreateCommand": "uv sync && uv run wb setup",
  "forwardPorts": [8090],
  "portsAttributes": { "8090": { "label": "Owlery (all KBs)" } }
}
